{
  "name": "tines-3b",
  "displayName": "Tines 3B",
  "version": "1.0.0",
  "description": "Explore, run, and build Tines 3B workflows from your agent.",
  "author": {
    "name": "Tines"
  },
  "homepage": "https://www.tines.com/3b/",
  "repository": "https://github.com/tines/tines-3b-integrations",
  "logo": "assets/logo.svg",
  "keywords": [
    "tines",
    "3b",
    "mcp",
    "workflows",
    "automation",
    "security",
    "orchestration"
  ],
  "category": "integrations",
  "tags": [
    "tines",
    "automation",
    "workflows",
    "mcp"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "TINES_3B_MCP_URL": {
        "type": "string",
        "title": "3B tenant MCP URL",
        "description": "Your 3B sign-in origin plus /mcp, for example https://acme.3b.dev/mcp. Copy the origin from your browser's address bar after signing in to 3B."
      }
    },
    "required": ["TINES_3B_MCP_URL"]
  },
  "mcpServers": {
    "tines-3b": {
      "type": "http",
      "url": "${TINES_3B_MCP_URL}"
    }
  },
  "skills": "./skills/"
}
